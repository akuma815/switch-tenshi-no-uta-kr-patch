 },
 {
  "file": "L10N/en/Ogix/Data/DT/Game_1/DT_Game1_GameInfo.uexp",
  "offset": 86,
  "old_encoding": "ascii",
  "old_length_field": 20,
  "old_text": "Released 10/25/1991",
  "new_text": "1991/10/25 발매"
 },
 {
  "file": "L10N/en/Ogix/Data/DT/Game_1/DT_Game1_GameInfo.uexp",
  "offset": 110,
  "old_encoding": "ascii",
  "old_length_field": 284,
  "old_text": "Cael and Claire are the heroes of this story.\nThis loving couple sets out to Cork Castle to receive a baptismal blessing for their wedding.\nMany tribulations await the joyous couple...\nDive into this RPG released in 1991 centered around a couple's love with a Celtic mythology twist.",
  "new_text": "케알과 클레어는 이 이야기의 주인공입니다.\n사랑하는 두 사람은 결혼 세례를 받으러 코크 성으로 떠납니다.\n행복한 두 사람 앞에는 수많은 시련이 기다리고 있는데...\n켈트 신화와 사랑을 그린 1991년 명작 RPG를 만나보세요."
 },
